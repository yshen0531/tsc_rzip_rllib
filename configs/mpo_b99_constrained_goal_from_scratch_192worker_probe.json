        "info_key": "Z_error",
        "tol": 0.035,
        "clip": 12.0
      },
      {
        "name": "Ip",
        "type": "abs_error",
        "info_key": "Ip_error",
        "tol": 4000.0,
        "clip": 12.0
      },
      {
        "name": "action",
        "type": "mean_abs_action",
        "target": 0.42,
        "clip": 12.0
      },
      {
        "name": "vessel",
        "type": "info_deadzone",
        "info_key": "vessel_current_abs_sum_a",
        "target": 220000.0,
        "clip": 12.0
      }
