{
  "run_name": "train_b99_constrained_goal_from_scratch_mpo_192worker_probe",
  "train_config": "configs/train_b99_constrained_goal_from_scratch_1ms.json",
  "seed": 42,
  "stop_env_steps": 2500000,
  "checkpoint_every_iters": 25,
  "log_root": "ray_results",
  "checkpoint_root": "mpo_checkpoints",
  "env": {
    "backend": "native",
    "finite_guard": {
      "enabled": true,
      "nonfinite_penalty": -10000.0,
      "terminate_on_nonfinite": true
    }
  },
  "parallel": {
    "ray_address": null,
    "ray_num_cpus": 200,
    "include_dashboard": false,
    "object_store_memory": 8589934592,
    "num_tsc_workers": 192,
    "num_cpus_per_tsc_worker": 1,
    "sample_timeout_s": 3600.0,
    "fragment_steps": 32,
    "actor_sync_interval_iters": 1,
    "rollout_deterministic": false
  },
  "learner": {
    "num_gpus": 0
  },
  "model": {
    "activation": "silu",
    "actor_gru_hidden": 128,
    "critic_gru_hidden": 256,
    "actor_mlp_hiddens": [
      256,
      256
    ],
    "critic_mlp_hiddens": [
      512,
      512
    ],
    "log_std_min": -3.5,
    "log_std_max": -0.5,
    "physics_blend": {
      "enabled": false,
      "description": "B99 disables fixed physics blend for the clean from-scratch constrained goal-conditioned baseline. Physics priors can be reintroduced only after target sensitivity is verified."
    },
    "goal_conditioning": {
      "enabled": true,
      "append_to_observation": true,
      "features": [
        "target_R_delta_norm",
        "target_Z_delta_norm",
        "target_Ip_delta_norm"
      ],
      "scales": {
        "R_scale_m": 0.04,
        "Z_scale_m": 0.04,
        "Ip_scale_a": 2500.0
      },
      "description": "B99 goal-conditioned policy: explicit command target deltas are present from the start of training."
    }
  },
  "privileged": {
    "include_currents": true,
    "current_scale_a": 1000.0,
    "clip": 50.0,
    "keys": [
      "R_error_norm",
      "Z_error_norm",
      "Ip_error_norm",
      "velocity_norm",
      "vessel_current_total_a",
      "vessel_current_signed_sum_a",
      "vessel_current_abs_sum_a",
      "vessel_current_rms_a",
      "vessel_current_max_abs_a",
      "current_util_max",
      "episode_max_abs_R_error",
      "episode_max_abs_Z_error",
      "episode_max_abs_Ip_error",
      "episode_max_current_util",
      "episode_max_velocity_norm",
      "episode_max_vessel_total_abs_a",
      "episode_max_vessel_abs_sum_a",
      "raw_progress",
      "error_growth",
      "tracking_penalty",
      "hold_weight"
    ]
  },
  "replay": {
    "capacity_fragments": 80000
  },
  "mpo": {
    "gamma": 0.997,
    "tau": 0.005,
    "actor_lr": 5e-05,
    "critic_lr": 0.0002,
    "eta_lr": 0.0001,
    "eta_init": 1.0,
    "eta_min": 0.001,
    "eta_epsilon": 0.35,
    "kl_target": 0.006,
    "kl_coeff": 20.0,
    "entropy_coeff": 0.003,
    "grad_clip": 5.0,
    "warmup_steps": 150000,
    "batch_size": 256,
    "sequence_len": 32,
    "updates_per_iter": 24,
    "num_action_samples": 16,
    "target_policy_noise": 0.0,
    "target_noise_clip": 0.3,
    "eta_max": 3.0,
    "critic_loss": "huber",
    "huber_delta": 10.0,
    "reward_scale": 0.05,
    "reward_clip": [
      -500.0,
      100.0
    ],
    "target_q_clip": [
      -2500.0,
      250.0
    ],
    "actor_action_l2_coeff": 0.01,
    "actor_action_saturation_coeff": 10.0,
    "actor_action_soft_limit": 0.55,
    "e_step_center_q": true,
    "e_step_normalize_q": true,
    "e_step_q_clip": 4.0,
    "actor_update_every": 2,
    "policy_loss_clip": null,
    "actor_output_scale": 0.45,
    "actor_output_scale_init": 0.45,
    "actor_output_scale_schedule": [
      [
        0,
        0.45
      ],
      [
        300000,
        0.55
      ],
      [
        900000,
        0.62
      ],
      [
        1800000,
        0.55
      ]
    ],
    "policy_loss_lower_clip": -20.0,
    "policy_loss_upper_clip": null,
    "actor_mode_coeff_l2": {},
    "actor_mode_coeff_saturation": {
      "names": [],
      "soft_limit": 1.0,
      "coeff": 0.0
    },
    "actor_raw_pf_vertical_diff_when_r_neg": {
      "enabled": false,
      "coeff": 0.0
    }
  },
  "deterministic_probe": {
    "enabled": true,
    "every_iters": 25,
    "eval_stage": "final",
    "seed": 12345
  },
  "early_stop": {
    "enabled": false,
    "note": "B99 from-scratch algorithmic run; do not stop before target-sensitivity diagnostics are available."
  },
  "stochastic_probe": {
    "enabled": true,
    "every_iters": 25,
    "eval_stage": "final",
    "seed": 22345
  },
  "description": "B99 from-scratch goal-conditioned constrained MPO: no checkpoint resume, no physics-blend prior; reward/cost balance handled by learned dual variables.",
  "local_target_grid_probe": {
    "enabled": true,
    "every_iters": 25,
    "eval_stage": "final",
    "seed": 33345,
    "R_values": [
      0.7,
