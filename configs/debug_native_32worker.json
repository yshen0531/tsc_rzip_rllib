{
  "run_name": "debug_native_32worker",
  "stop_env_steps": 3840,
  "checkpoint_every_iters": 4,

  "env": {
    "backend": "native",
    "disable_env_checking": false
  },

  "parallel": {
    "ray_num_cpus": 40,
    "object_store_memory": 2147483648,

    "reserve_cpus": 4,
    "num_tsc_workers": 32,
    "num_envs_per_tsc_worker": 1,
    "num_cpus_per_tsc_worker": 1,

    "sample_timeout_s": 1800.0,
    "max_requests_in_flight_per_tsc_worker": 1,
    "rollout_fragment_length": "auto",
    "batch_mode": "truncate_episodes"
  },

  "learner": {
    "num_learners": 1,
    "num_cpus_per_learner": 3,
    "num_gpus_per_learner": 0
  },

  "sac": {
    "num_steps_sampled_before_learning_starts": 600,
    "train_batch_size_per_learner": 1024,
    "replay_buffer_config": {
      "type": "PrioritizedEpisodeReplayBuffer",
      "capacity": 100000,
      "alpha": 0.6,
      "beta": 0.4
    }
  },

  "reporting": {
    "min_sample_timesteps_per_iteration": 200
  }
}