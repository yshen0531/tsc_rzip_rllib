{
  "run_name": "debug_mock_rllib_sac",
  "stop_env_steps": 2000,
  "checkpoint_every_iters": 2,

  "env": {
    "backend": "mock",
    "disable_env_checking": false,
    "mock_config": {
      "max_episode_steps": 80,
      "noise": 0.0
    }
  },

  "parallel": {
    "reserve_cpus": 1,
    "num_tsc_workers": 2,
    "num_envs_per_tsc_worker": 1,
    "num_cpus_per_tsc_worker": 1,
    "sample_timeout_s": 60.0
  },

  "learner": {
    "num_learners": 1,
    "num_cpus_per_learner": 1,
    "num_gpus_per_learner": 0
  },

  "sac": {
    "num_steps_sampled_before_learning_starts": 200,
    "train_batch_size_per_learner": 128,
    "replay_buffer_config": {
      "type": "PrioritizedEpisodeReplayBuffer",
      "capacity": 10000,
      "alpha": 0.6,
      "beta": 0.4
    }
  },

  "reporting": {
    "min_sample_timesteps_per_iteration": 20
  }
}
