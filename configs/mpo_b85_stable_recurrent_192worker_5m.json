{
  "run_name": "train_b85_stable_recurrent_mpo_192worker_5m",
  "train_config": "configs/train_b85_stable_mpo_fixed_target_1ms.json",
  "seed": 42,
  "stop_env_steps": 5000000,
  "checkpoint_every_iters": 25,
  "log_root": "ray_results",
  "checkpoint_root": "mpo_checkpoints",
  "env": {
    "backend": "native",
    "finite_guard": {
      "enabled": true,
      "nonfinite_penalty": -10000.0,
      "terminate_on_nonfinite": true
    }
  },
  "parallel": {
    "ray_address": null,
    "ray_num_cpus": 200,
    "include_dashboard": false,
    "object_store_memory": 8589934592,
    "num_tsc_workers": 192,
    "num_cpus_per_tsc_worker": 1,
    "sample_timeout_s": 3600.0,
    "fragment_steps": 32,
    "actor_sync_interval_iters": 1,
    "rollout_deterministic": false
  },
  "learner": {
    "num_gpus": 0
  },
  "model": {
    "activation": "silu",
    "actor_gru_hidden": 128,
    "critic_gru_hidden": 256,
    "actor_mlp_hiddens": [
      256,
      256
    ],
    "critic_mlp_hiddens": [
      512,
      512
    ],
    "log_std_min": -5.0,
    "log_std_max": 0.3
  },
  "privileged": {
    "include_currents": true,
    "current_scale_a": 1000.0,
    "clip": 50.0,
    "keys": [
      "R_error_norm",
      "Z_error_norm",
      "Ip_error_norm",
      "velocity_norm",
      "vessel_current_total_a",
      "vessel_current_signed_sum_a",
      "vessel_current_abs_sum_a",
      "vessel_current_rms_a",
      "vessel_current_max_abs_a",
      "current_util_max",
      "episode_max_abs_R_error",
      "episode_max_abs_Z_error",
      "episode_max_abs_Ip_error",
      "episode_max_current_util",
      "episode_max_velocity_norm",
      "episode_max_vessel_total_abs_a",
      "episode_max_vessel_abs_sum_a",
      "raw_progress",
      "error_growth",
      "tracking_penalty",
      "hold_weight"
    ]
  },
  "replay": {
    "capacity_fragments": 80000
  },
  "mpo": {
    "gamma": 0.997,
    "tau": 0.005,
    "actor_lr": 3e-05,
    "critic_lr": 0.0001,
    "eta_lr": 0.0001,
    "eta_init": 1.0,
    "eta_min": 0.001,
    "eta_epsilon": 0.35,
    "kl_target": 0.008,
    "kl_coeff": 12.0,
    "entropy_coeff": 0.0,
    "grad_clip": 5.0,
    "warmup_steps": 120000,
    "batch_size": 256,
    "sequence_len": 32,
    "updates_per_iter": 24,
    "num_action_samples": 16,
    "target_policy_noise": 0.0,
    "target_noise_clip": 0.3,
    "eta_max": 5.0,
    "critic_loss": "huber",
    "huber_delta": 10.0,
    "reward_scale": 0.05,
    "reward_clip": [
      -500.0,
      100.0
    ],
    "target_q_clip": [
      -2000.0,
      200.0
    ],
    "actor_action_l2_coeff": 0.05,
    "actor_action_saturation_coeff": 8.0,
    "actor_action_soft_limit": 0.55,
    "e_step_center_q": true,
    "e_step_normalize_q": true,
    "e_step_q_clip": 6.0
  }
}