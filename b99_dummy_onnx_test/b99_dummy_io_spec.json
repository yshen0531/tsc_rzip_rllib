        "batch",
        53
      ],
      "description": "B99 policy observation vector. Dummy model ignores values; real model must use training obs order."
    },
    {
      "name": "h_in",
      "dtype": "float32",
      "shape": [
        1,
        "batch",
        128
      ],
      "description": "LSTM hidden state input. Use zeros at episode start."
    },
    {
      "name": "c_in",
      "dtype": "float32",
      "shape": [
        1,
        "batch",
        128
      ],
      "description": "LSTM cell state input. Use zeros at episode start."
    }
  ],
  "outputs": [
    {
      "name": "action_norm",
      "dtype": "float32",
      "shape": [
        "batch",
        14
      ],
      "description": "Normalized action in [-1, 1], coil order below."
    },
    {
      "name": "delta_current_a",
      "dtype": "float32",
      "shape": [
        "batch",
        14
      ],
      "description": "Per-step current increment in A = action_norm * 3.0."
    },
    {
      "name": "h_out",
      "dtype": "float32",
      "shape": [
        1,
        "batch",
        128
      ],
      "description": "Next LSTM hidden state."
    },
    {
      "name": "c_out",
      "dtype": "float32",
      "shape": [
        1,
        "batch",
        128
      ],
      "description": "Next LSTM cell state."
    }
  ],
