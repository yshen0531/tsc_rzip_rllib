{
  "model_kind": "B99 dummy recurrent policy ONNX I/O test model",
  "note": "Dummy weights only. This is not a trained controller.",
  "obs_dim": 53,
  "action_dim": 14,
  "hidden_size": 128,
  "num_layers": 1,
  "max_delta_current_a": 3.0,
  "coil_order": [
    "CS1U",
    "CS1L",
    "CS2U",
    "CS2L",
    "CS3U",
    "CS3L",
    "CS4U",
    "CS4L",
    "PF2U",
    "PF2L",
    "PF3U",
