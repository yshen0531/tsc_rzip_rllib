  "scientific_design": {
    "r9_source_audit": "Recomputes all 54 R9 raw development rollouts and requires the observed 18/18 delay=0 pass, 0/36 delay=1/2 pass structure, healthy solver/queue semantics, and exact policy identity before the first terminal command can affect the plant.",
    "causal_transition_preview": "For delay d, replaces exactly the last d issue slots (34 for d=1; 33 and 34 for d=2) that cannot have affected the physical state through 350 ms. Each replacement is computed at its original issue time from only states and pending commands then available.",
    "frozen_prefix": "Requires bit-exact physical and applied-command prefixes through 350 ms and an exact audit copy of the original issued-command trace. Only still-unapplied issue slots may differ.",
    "terminal_feedback": "Runs 40 continuously streaming explicit-delay-queue feedback steps from 350 to 750 ms using clean direct R/Z/Ip measurements and finite-difference R/Z velocity.",
    "candidate_development": "Tests six independently interpretable policies on nominal across all nine delay/slew pairs: exact R9 structural baseline, earlier template only, controller-scale only, velocity-gain only, position-gain only, and one combined stronger/earlier policy.",
    "disjoint_holdout": "Tests the selected policy once on RZ_p10_m10 over all nine pairs without using holdout results for policy selection.",
    "calibrated_confirmation": "Reuses only the nine trusted/correct pair-level R8 calibration tokens and requires all 18 calibrated trajectories to be trace-equivalent to their Oracle counterparts.",
    "hard_gates": "Keeps 30 mm position, 0.1 m/s speed and frozen Ip gates; adds tail-box, last-100ms speed/position, final pending-command and last-100ms command-convergence guards.",
